  "protocol": {
    "n_seeds": 10,
    "max_epochs": 200,
    "arms": [
      "edubind",
      "map",
      "hrr",
      "concat"
    ],
    "ci": "percentile bootstrap over seeds (NOT a pooled binomial interval)",
    "transductive": "test pairs held out; every seed redraws the test subsample",
    "inductive": "node split redrawn INSIDE the seed loop, so each seed is an independent (split, init) draw; both nodes of every test pair unseen",
    "validation": "D3 fix: 15% held out INDEPENDENTLY per hop stratum (hop2-3/hop4-6/hop7+) from the training pool, NOT a single pooled split -- a pooled split let the ~13x-larger hop4-6/hop7+ pools drown out hop2-3's stopping signal. Early-stops on the unweighted mean of the three per-stratum validation accuracies, patience=5 after at least 15 epochs, restoring the best-validation checkpoint before test evaluation. 'direct'/'expert' augmentation pairs are never held out. Test strata are never used for the stopping decision.",
    "note": "dir_acc_strict uses f(u,v) > f(v,u); commutative arms tie exactly, so dir_acc_tiebreak = (wins + ties/2)/n is also reported"
  },
